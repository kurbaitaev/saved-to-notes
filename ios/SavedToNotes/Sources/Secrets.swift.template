import Foundation

/// Filled by ios/configure.sh from the project's .env so the token is never
/// typed into a file that git tracks. See ios/README.md.
enum Secrets {
    static let notionToken = "__NOTION_TOKEN__"
    static let notionDatabaseID = "__NOTION_DATABASE_ID__"
    static var configured: Bool { !notionToken.hasPrefix("__") }
}
