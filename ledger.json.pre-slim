                  "type": "paragraph",
                  "text": "Compass direction 1 — Expertise (North): industry observations, insights, myths, recurring mistakes"
                }
              ]
            },
            {
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Compass direction 2 — Beliefs (South): opinions, values, lessons that changed how you think"
                }
              ]
            },
            {
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Compass direction 3 — Process (East): BTS, client transformations, case studies"
                }
              ]
            },
            {
              "blocks": [
