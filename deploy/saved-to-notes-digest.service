[Unit]
Description=saved-to-notes weekly digest

[Service]
Type=oneshot
WorkingDirectory=__DIR__
# A user unit's PATH omits ~/.local/bin, where the Claude CLI installs.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__PYTHON__ __DIR__/digest.py
StandardOutput=append:__DIR__/logs/digest.out.log
StandardError=append:__DIR__/logs/digest.err.log
