<?xml version="1.0" encoding="UTF-8"?>
<!-- Reading-machine job: pull new notes from the private vault repo every 5 minutes
     and push any local edits. Installed by install-mac-reader.sh. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__-vaultpull</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__DIR__/vault_sync.sh</string>
        <string>pull</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__DIR__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>__DIR__/logs/vaultpull.out.log</string>
    <key>StandardErrorPath</key>
    <string>__DIR__/logs/vaultpull.err.log</string>
</dict>
</plist>
